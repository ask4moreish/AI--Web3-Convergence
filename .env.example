# Copy to .env and fill in your values. Never commit .env.

# Stellar keypair for the API server's read-only service account
STELLAR_SECRET=S...

# Deployed contract addresses (after: stellar contract deploy ...)
REGISTRY_CONTRACT_ID=C...
REPUTATION_CONTRACT_ID=C...
TASK_MARKET_CONTRACT_ID=C...

# Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK=TESTNET
